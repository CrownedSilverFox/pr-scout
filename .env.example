# --- Jev ---
# NordRouter (default here): the account API key works directly, model typesafe-ai/jev.
NORDROUTER_API_KEY=
JEV_API_URL=https://nordrouter.com/v1/evaluate
JEV_MODEL=typesafe-ai/jev
# USD per 1M input tokens, used only for the cost panel. NordRouter charges $0.05,
# TypeSafe's list price is $0.042. Measured from the X-Charged-USD response header.
JEV_PRICE_PER_MTOK=0.05

# TypeSafe instead of NordRouter: leave the two lines above and use this key with
# JEV_API_URL=https://api.typesafe.ai/v1/systemone and JEV_MODEL=jev-latest.
TYPESAFE_API_KEY=

# Recommended: protects the UI with HTTP Basic auth (any user name, this password)
APP_PASSWORD=

# Recommended: a GitHub token without scopes — 5000 req/h instead of 60, CI status of finalists.
# Required for the fetch step: the GitHub GraphQL API does not answer anonymously.
GITHUB_TOKEN=

# Optional: Ollama for writing missing PR descriptions
OLLAMA_URL=http://host.docker.internal:11434

# Descriptions without a GPU: the same job through NordRouter's chat endpoint.
# provider=nordrouter in the project/preset config selects it.
NORDROUTER_URL=https://nordrouter.com
DESCRIBER_MODEL=google/gemini-3.1-flash-lite
DESCRIBER_WORKERS=6

# Optional: host port for the UI
SCOUT_PORT=8000

# Optional: concurrency. NordRouter rate-limits /v1/evaluate to 15 rps, so 14/10 is the safe
# ceiling; raise both for TypeSafe.
JEV_STAGE1_WORKERS=14
JEV_STAGE2_WORKERS=10
