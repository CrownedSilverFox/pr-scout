# Required: Jev (TypeSafe) API key — https://console.typesafe.ai
TYPESAFE_API_KEY=

# Recommended: protects the UI with HTTP Basic auth (any user name, this password)
APP_PASSWORD=

# Recommended: a GitHub token without scopes — 5000 req/h instead of 60, CI status of finalists
GITHUB_TOKEN=

# Optional: Ollama for writing missing PR descriptions
OLLAMA_URL=http://host.docker.internal:11434

# Optional: host port for the UI
SCOUT_PORT=8000
